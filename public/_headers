# Cloudflare Pages response headers.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'

# Assets are referenced by stable filenames - a screenshot replaced in place
# keeps its name - so they must stay revalidatable. "immutable" here would
# pin a replaced or deleted file in caches for the whole max-age.
/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/styles.css
  Cache-Control: public, max-age=3600

/site.js
  Cache-Control: public, max-age=3600
